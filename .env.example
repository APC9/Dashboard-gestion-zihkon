# =============================================================================
# Zihkon Admin — variables de entorno
# Copia este archivo a .env (o defínelas en Coolify). NUNCA subas valores reales.
# Ningún secreto debe llevar el prefijo NEXT_PUBLIC_ (se expondría al navegador).
# =============================================================================

# --- PostgreSQL existente (fuente de verdad) --------------------------------
# Recomendado: un usuario con permisos SELECT/INSERT/UPDATE (sin DROP/ALTER).
DATABASE_URL=

# --- Autenticación (NextAuth) ------------------------------------------------
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública del panel, p. ej. https://admin.zihkon.com
NEXTAUTH_URL=

# Administrador (FASE 1). Genera el hash con: npm run hash-password -- "tu-contraseña"
# Usa la versión base64 que imprime el script (evita problemas con los "$" en Docker).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrador Zihkon

# --- n8n: webhooks (obligatorio para lanzar automatizaciones) ----------------
# p. ej. https://n8n.zihkon.com/webhook
N8N_WEBHOOK_BASE_URL=
# Secreto compartido; configúralo en n8n como Header Auth "X-Zihkon-Secret".
N8N_WEBHOOK_SECRET=
# N8N_WEBHOOK_TIMEOUT_MS=15000

# Rutas de cada webhook (opcional; valores por defecto entre paréntesis)
# N8N_PATH_CONTENT_GENERATION=   (zihkon/content/generate)
# N8N_PATH_WEBSITE_CHANGE=       (zihkon/website/change)
# N8N_PATH_WEBSITE_PREVIEW=      (zihkon/website/preview)
# N8N_PATH_WEBSITE_PUBLISH=      (zihkon/website/publish)
# N8N_PATH_GBP_REVIEW_APPROVAL=  (zihkon/gbp/review-approved)
# N8N_PATH_GBP_REVIEW_PUBLISH=   (zihkon/gbp/review-publish)
# N8N_PATH_GBP_REVIEW_REGENERATE=(zihkon/gbp/review-regenerate)
# N8N_PATH_GBP_SYNC_REVIEWS=     (zihkon/gbp/sync-reviews)
# N8N_PATH_GBP_LIST_ACCOUNTS=    (zihkon/gbp/accounts)
# N8N_PATH_AUDIT_GENERATION=     (zihkon/audit/generate)
# N8N_PATH_CLIENT_ONBOARDING=    (zihkon/client/onboarding)
# N8N_PATH_CLIENT_AUTOMATIONS=   (zihkon/client/automations-changed)

# --- n8n: API REST (opcional, para ver ejecuciones en Automatizaciones) ------
# p. ej. https://n8n.zihkon.com
N8N_API_URL=
N8N_API_KEY=

# --- Público ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# Puerto del host para docker compose (opcional)
# APP_PORT=3000

# --- Stripe (cobros) -----------------------------------------------------------
# Desarrollo: claves de MODO TEST (sk_test_…) o el emulador local (ver docs/STRIPE.md). Nunca sk_live_ en local.
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook (whsec_…): en local lo da `stripe listen`; en producción, el panel de Stripe.
STRIPE_WEBHOOK_SECRET=
# Solo desarrollo con el emulador: http://localhost:4000 (vacío = API real de Stripe).
# STRIPE_API_BASE=
# Tipo de IVA 21 % exclusivo creado en Stripe (txr_…): node scripts/stripe-sync-catalog.mjs --tax-rate
# STRIPE_TAX_RATE_ID=
