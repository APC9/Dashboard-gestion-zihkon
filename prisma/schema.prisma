// =============================================================================
// Zihkon Admin — Prisma schema sobre la base de datos PostgreSQL EXISTENTE.
//
// ⚠️  NO ejecutar `prisma migrate dev`, `prisma migrate reset` ni `prisma db push`
//     contra la base de datos de producción. Este schema solo se usa para
//     generar el cliente tipado (`prisma generate`).
//
// Para comparar con el esquema real sin modificar nada:
//     npm run db:inspect      (prisma db pull --print → solo imprime)
//
// Decisiones:
//  - Todos los campos no-PK son opcionales (`?`) porque no conocemos con
//    certeza la nulabilidad real; así una fila con NULL nunca rompe la lectura.
//  - Las relaciones se declaran a nivel Prisma para poder hacer `include`.
//    Prisma no necesita que existan FOREIGN KEYs reales para consultar.
//  - gbp_clients.client_id → clients.client_id (FK real, ON DELETE RESTRICT).
//    El nombre y el WhatsApp del negocio se leen siempre de clients.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Clientes principales
// -----------------------------------------------------------------------------

model Client {
  clientId       String    @id @default(uuid()) @map("client_id") @db.Uuid
  clientName     String?   @map("client_name")
  whatsappE164   String?   @map("whatsapp_e164")
  driveFolderId  String?   @map("drive_folder_id")
  googleSheetId  String?   @map("google_sheet_id")
  googleSheetTab String?   @map("google_sheet_tab")
  timezone       String?
  active         Boolean?
  createdAt      DateTime? @default(now()) @map("created_at")

  websites          ClientWebsite[]
  contentIntakes    ContentIntake[]
  contentSessions   ContentSession[]
  processedMessages ProcessedMessage[]
  gbpProfiles       GbpClient[]
  automations       ClientAutomation[]
  billing           ClientBilling?
  billingItems      ClientBillingItem[]
  billingCheckouts  BillingCheckout[]
  billingPayments   BillingPayment[]

  @@map("clients")
}

model ClientWebsite {
  websiteId          String    @id @default(uuid()) @map("website_id") @db.Uuid
  clientId           String?   @map("client_id") @db.Uuid
  githubOwner        String?   @map("github_owner")
  githubRepository   String?   @map("github_repository")
  defaultBranch      String?   @map("default_branch")
  netlifySiteId      String?   @map("netlify_site_id")
  websiteUrl         String?   @map("website_url")
  previewModeEnabled Boolean?  @map("preview_mode_enabled")
  active             Boolean?
  createdAt          DateTime? @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [clientId])

  @@map("client_websites")
}

// -----------------------------------------------------------------------------
// Contenido recibido por WhatsApp
// -----------------------------------------------------------------------------

model ContentIntake {
  intakeId        String    @id @default(uuid()) @map("intake_id") @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  sourceMessageId String?   @map("source_message_id")
  description     String?
  status          String?
  expectedCount   Int?      @map("expected_count")
  createdAt       DateTime? @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  expiresAt       DateTime? @map("expires_at")

  client   Client?          @relation(fields: [clientId], references: [clientId])
  media    ContentMedia[]
  sessions ContentSession[]

  @@map("content_intakes")
}

model ContentMedia {
  mediaId           String    @id @default(uuid()) @map("media_id") @db.Uuid
  intakeId          String?   @map("intake_id") @db.Uuid
  providerMessageId String?   @map("provider_message_id")
  mediaType         String?   @map("media_type")
  mimeType          String?   @map("mime_type")
  originalFileName  String?   @map("original_file_name")
  driveFileId       String?   @map("drive_file_id")
  driveUrl          String?   @map("drive_url")
  position          Int?
  createdAt         DateTime? @default(now()) @map("created_at")
  metadata          Json?     @db.JsonB

  intake ContentIntake? @relation(fields: [intakeId], references: [intakeId])

  @@map("content_media")
}

model ContentSession {
  sessionId            String    @id @default(uuid()) @map("session_id") @db.Uuid
  instanceId           String?   @map("instance_id")
  remoteJid            String?   @map("remote_jid")
  clientId             String?   @map("client_id") @db.Uuid
  contentIntakeId      String?   @map("content_intake_id") @db.Uuid
  startMessageId       String?   @map("start_message_id")
  status               String?
  mediaType            String?   @map("media_type")
  mediaCount           Int?      @map("media_count")
  description          String?
  createdAt            DateTime? @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")
  completedAt          DateTime? @map("completed_at")
  expiresAt            DateTime? @map("expires_at")
  readyMessageId       String?   @map("ready_message_id")
  descriptionMessageId String?   @map("description_message_id")

  client Client?               @relation(fields: [clientId], references: [clientId])
  intake ContentIntake?        @relation(fields: [contentIntakeId], references: [intakeId])
  media  ContentSessionMedia[]

  @@map("content_sessions")
}

model ContentSessionMedia {
  sessionMediaId   String    @id @default(uuid()) @map("session_media_id") @db.Uuid
  sessionId        String?   @map("session_id") @db.Uuid
  instanceId       String?   @map("instance_id")
  messageId        String?   @map("message_id")
  mediaType        String?   @map("media_type")
  mimeType         String?   @map("mime_type")
  filename         String?
  mediaReference   String?   @map("media_reference")
  driveFileId      String?   @map("drive_file_id")
  driveUrl         String?   @map("drive_url")
  caption          String?
  messageTimestamp DateTime? @map("message_timestamp")
  position         Int?
  fileSize         BigInt?   @map("file_size")
  status           String?
  createdAt        DateTime? @default(now()) @map("created_at")
  metadata         Json?     @db.JsonB

  session ContentSession? @relation(fields: [sessionId], references: [sessionId])

  @@map("content_session_media")
}

model ProcessedMessage {
  providerMessageId String    @id @map("provider_message_id")
  clientId          String?   @map("client_id") @db.Uuid
  status            String?
  receivedAt        DateTime? @map("received_at")
  error             String?

  client Client? @relation(fields: [clientId], references: [clientId])

  @@map("processed_messages")
}

// -----------------------------------------------------------------------------
// Google Business Profile (perfiles enlazados a clients por client_id)
// -----------------------------------------------------------------------------

model GbpClient {
  id                   String    @id @default(uuid()) @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  locationId           String    @map("location_id")
  accountId            String    @map("account_id")
  businessType         String?   @map("business_type")
  active               Boolean?
  responseTone         String?   @map("response_tone")
  preferredLanguage    String?   @map("preferred_language")
  responseMode         String?   @map("response_mode")
  customAiInstructions String?   @map("custom_ai_instructions")
  telegramChatId       String?   @map("telegram_chat_id")
  delayMinutes         Int?      @map("delay_minutes")
  contactEmail         String?   @map("contact_email")
  createdAt            DateTime? @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  client  Client               @relation(fields: [clientId], references: [clientId])
  reviews GbpReviewActivity[]
  errors  GbpAutomationError[]

  @@map("gbp_clients")
}

model GbpReviewActivity {
  id                   Int       @id @default(autoincrement())
  clientId             String?   @map("client_id") @db.Uuid
  reviewId             String?   @map("review_id")
  reviewerName         String?   @map("reviewer_name")
  rating               String?
  reviewText           String?   @map("review_text")
  reviewDate           DateTime? @map("review_date")
  existingResponse     String?   @map("existing_response")
  generatedResponse    String?   @map("generated_response")
  status               String?
  scheduledPublishDate DateTime? @map("scheduled_publish_date")
  createdDate          DateTime? @default(now()) @map("created_date")
  approvedDate         DateTime? @map("approved_date")
  publishedDate        DateTime? @map("published_date")
  errorDetails         String?   @map("error_details")

  gbpClient GbpClient?           @relation(fields: [clientId], references: [id])
  errors    GbpAutomationError[]

  @@map("gbp_review_activity")
}

model GbpAutomationError {
  id           Int       @id @default(autoincrement())
  stage        String?
  clientId     String?   @map("client_id") @db.Uuid
  reviewDbId   Int?      @map("review_db_id")
  errorMessage String?   @map("error_message")
  createdAt    DateTime? @default(now()) @map("created_at")

  gbpClient GbpClient?         @relation(fields: [clientId], references: [id])
  review    GbpReviewActivity? @relation(fields: [reviewDbId], references: [id])

  @@map("gbp_automation_errors")
}

// -----------------------------------------------------------------------------
// Auditorías locales (leads / informes)
// -----------------------------------------------------------------------------

model AuditoriaLocal {
  id                 BigInt    @id @default(autoincrement())
  emailNormalizado   String?   @map("email_normalizado")
  negocioClave       String?   @map("negocio_clave")
  email              String?
  nombreNegocio      String?   @map("nombre_negocio")
  direccion          String?
  googlePlaces       Json?     @map("google_places") @db.JsonB
  informe            Json?     @db.JsonB
  pdfUrl             String?   @map("pdf_url")
  driveFileId        String?   @map("drive_file_id")
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  createdAt          DateTime? @default(now()) @map("created_at")

  @@map("auditorias_locales")
}

// -----------------------------------------------------------------------------
// Administradores de automatizaciones (teléfonos autorizados en WhatsApp)
// -----------------------------------------------------------------------------

model AutomationAdmin {
  phoneE164 String    @id @map("phone_e164")
  active    Boolean?
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("automation_admins")
}

// -----------------------------------------------------------------------------
// Automatizaciones contratadas por cliente (proposed-migrations/004)
// -----------------------------------------------------------------------------

model AutomationCatalog {
  automationKey String    @id @map("automation_key")
  name          String
  description   String?
  sortOrder     Int       @default(0) @map("sort_order")
  active        Boolean   @default(true)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  clients ClientAutomation[]

  @@map("automation_catalog")
}

model ClientAutomation {
  clientId      String    @map("client_id") @db.Uuid
  automationKey String    @map("automation_key")
  enabled       Boolean   @default(true)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  client     Client            @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  automation AutomationCatalog @relation(fields: [automationKey], references: [automationKey])

  @@id([clientId, automationKey])
  @@map("client_automations")
}

// -----------------------------------------------------------------------------
// Cobros con Stripe (proposed-migrations/007). Importes en céntimos, sin IVA.
// -----------------------------------------------------------------------------

model BillingPlan {
  planKey              String    @id @map("plan_key")
  name                 String
  kind                 String
  automationKeys       String[]  @map("automation_keys")
  setupAmountCents     Int       @map("setup_amount_cents")
  monthlyAmountCents   Int       @map("monthly_amount_cents")
  yearlyAmountCents    Int?      @map("yearly_amount_cents")
  currency             String    @default("eur")
  stripeProductId      String?   @map("stripe_product_id")
  stripeSetupPriceId   String?   @map("stripe_setup_price_id")
  stripeMonthlyPriceId String?   @map("stripe_monthly_price_id")
  stripeYearlyPriceId  String?   @map("stripe_yearly_price_id")
  sortOrder            Int       @default(0) @map("sort_order")
  active               Boolean   @default(true)
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  items ClientBillingItem[]

  @@map("billing_plans")
}

model ClientBilling {
  clientId             String    @id @map("client_id") @db.Uuid
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  status               String    @default("none")
  billingInterval      String?   @map("billing_interval")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  billingName          String?   @map("billing_name")
  billingEmail         String?   @map("billing_email")
  taxId                String?   @map("tax_id")
  billingAddress       Json?     @map("billing_address")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@map("client_billing")
}

model ClientBillingItem {
  clientId                 String    @map("client_id") @db.Uuid
  planKey                  String    @map("plan_key")
  stripeSubscriptionItemId String?   @map("stripe_subscription_item_id")
  status                   String    @default("pending")
  createdAt                DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  client Client      @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  plan   BillingPlan @relation(fields: [planKey], references: [planKey])

  @@id([clientId, planKey])
  @@map("client_billing_items")
}

model BillingCheckout {
  checkoutSessionId    String    @id @map("checkout_session_id")
  clientId             String    @map("client_id") @db.Uuid
  planKeys             String[]  @map("plan_keys")
  billingInterval      String    @map("billing_interval")
  status               String    @default("open")
  url                  String?
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  createdBy            String?   @map("created_by")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@map("billing_checkouts")
}

model BillingPayment {
  paymentId      BigInt    @id @default(autoincrement()) @map("payment_id")
  stripeObjectId String    @unique @map("stripe_object_id")
  clientId       String?   @map("client_id") @db.Uuid
  concept        String
  subtotalCents  Int       @map("subtotal_cents")
  taxCents       Int       @map("tax_cents")
  totalCents     Int       @map("total_cents")
  currency       String    @default("eur")
  paymentMethod  String?   @map("payment_method")
  status         String
  billingName    String?   @map("billing_name")
  taxId          String?   @map("tax_id")
  billingAddress Json?     @map("billing_address")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz

  client Client? @relation(fields: [clientId], references: [clientId], onDelete: SetNull)

  @@map("billing_payments")
}

model StripeEvent {
  eventId     String    @id @map("event_id")
  type        String
  receivedAt  DateTime? @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?

  @@map("stripe_events")
}
